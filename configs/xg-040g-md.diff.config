# ============================================================================
# XG-040G-MD 的差异配置（不是完整 .config！）
#
# 用法：workflow 先 cp 上游 configs/an7581.config 作 .config（= 和上游一模一样），
#      再把本文件追加到末尾，最后 make defconfig 展开。
#      kconfig 后写覆盖先写，所以这里只需写「要改的」。
#
# 上游基座已经带了：AN758x target、PON 驱动( kmod-airoha-xpon /
# kmod-airoha-pon-frontend / kmod-airoha-en7572 )、PON 用户态( airoha-pond /
# airoha-ponctl )、luci-app-pon + 中文、kmod-nft-fullcone、jsonfilter、
# rpcd-mod-file、ip-full、libbpf/libelf、以及 12 个机型 profile
# （含 nokia_xg-040g-md-ubi 与 nokia_xg-040g-md-ubi-usb-sfp）。
# 所以本文件的净增内容只有下面两段，共 16 个符号。
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 两个附加 LuCI 插件（源码由 scripts/fetch-plugins.sh 按 pins.env 取，
#    放进 package/custom/ 后这两个符号才存在于索引里）
#      luci-app-natmode    ：网络 → NAT 类型（全锥形 NAT1 / 受限 NAT3 / 对称 NAT4）
#                            依赖 firewall4 + kmod-nft-fullcone（上游已 =y）
#      luci-app-pon-status ：状态 → 概览 的 PON 光模块卡片
#                            温度 / 收光 / 发光 / 偏置电流 / 供电电压
#                            依赖 airoha-ponctl + jsonfilter + rpcd-mod-file（上游已 =y）
#    注：这两个包自带界面，没有 po/ 目录，所以不需要 luci-i18n-*-zh-cn。
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-natmode=y
CONFIG_PACKAGE_luci-app-pon-status=y

# ---------------------------------------------------------------------------
# 2. 内核 BTF + eBPF 数据面（honk / dae 的前提）
#
#    OpenWrt 侧 Kconfig（config/Config-kernel.in）：
#      config KERNEL_DEBUG_INFO_BTF
#          depends on KERNEL_DEBUG_INFO && !KERNEL_DEBUG_INFO_REDUCED
#          select DWARVES
#
#    ★ 上游基座是 CONFIG_KERNEL_DEBUG_INFO_REDUCED=y，所以这一行必须在这里显式
#      关掉，否则 DEBUG_INFO_BTF 依赖不满足，make defconfig 会把它静默剔除，
#      编出来的内核没有 /sys/kernel/btf/vmlinux，honk 启动即失败。
#      关 REDUCED 后 DWARVES 被 select 自动带上 → tools/dwarves(pahole 1.31)
#      会被编成 host 工具，不用手动开 CONFIG_DWARVES。
#      这个组合就是 ImmortalWrt 官方 filogic 快照 config.buildinfo 里的写法
#      （BTF=y / REDUCED is not set / DWARVES=y），不是我们自己发明的。
#
#    BPF / BPF_SYSCALL / BPF_JIT 不写：BPF 无 prompt（由其它符号 select），
#    BPF_SYSCALL、BPF_JIT 由 target/linux/generic/config-6.18 提供 =y；
#    NET_XGRESS 由 target/linux/airoha/an7581/config-6.18 提供 =y；
#    CGROUP_BPF 上游基座已 =y。写进 .config 反而无效。
#
#    FTRACE 那 4 个只服务 honk 的「原生 API UDP 收包追踪」可选回退；
#    缺了 honk 也能跑，只是那一项元数据降级。BPF_EVENTS 会 select KPROBES。
#
#    代价：内核编译变慢、Image.gz 约 +1~3MB。本机型 KERNEL_IN_UBI=1 且
#    未写死 IMAGE_SIZE（内核独占动态 UBI 卷），不会顶到分区上限。
# ---------------------------------------------------------------------------
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_MODULE_ALLOW_BTF_MISMATCH=y
CONFIG_KERNEL_FTRACE=y
CONFIG_KERNEL_FUNCTION_TRACER=y
CONFIG_KERNEL_DYNAMIC_FTRACE=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_PACKAGE_kmod-sched-core=y             # TCX 挂接需要的 clsact / NET_CLS_ACT
CONFIG_PACKAGE_kmod-sched-bpf=y              # cls_bpf / act_bpf
CONFIG_PACKAGE_kmod-nft-queue=y              # honk 首包保留 UDP 的 NFQUEUE 通路
CONFIG_PACKAGE_kmod-nfnetlink-queue=y        # NETFILTER_NETLINK_QUEUE

# ---------------------------------------------------------------------------
# 4. honk 全套（预置在他们的签名 .apk 里，随固件放 /etc/apk/local/，首启离线安装）
#    下面这些是 honk 包的 DEPENDS，必须提前编进 rootfs，首启才能不联网装上：
#      libstdcpp  kmod-veth  kmod-sched-core  kmod-sched-bpf  kmod-nft-core
#      kmod-nft-queue  kmod-nfnetlink-queue  kmod-nf-conntrack  v2ray-geoip  v2ray-geosite
#    后四个上面已经开了，这里补齐剩下的。
#    v2ray-geoip / v2ray-geosite 来自 packages feed 的 v2ray-geodata 分包（geo 规则文件）。
#    ★ 不选 vmlinux-btf：那是给"内核没有 BTF"的官方内核准备的 blob；我们自带 BTF，
#      由预置的空包 vmlinux-btf-builtin 满足 honk 的 +vmlinux-btf 依赖。
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# ---------------------------------------------------------------------------
# 5. 主题：我自己写的 luci-theme-lucent（源码由 scripts/fetch-plugins.sh 按
#    pins.env 的 THEME_SHA 取到 package/custom/，仓库根目录就是包本体）
#    保留 bootstrap 兜底：主题万一出问题还能用默认界面进系统，不至于瞎。
#    默认主题在 LuCI 里切（该主题自带 settings 页和 rpcd 插件 luci.lucent），
#    构建里不猜它的 UCI 键名。
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci-theme-lucent=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# ---------------------------------------------------------------------------
# 3. 机型收敛：上游基座一次出 12 个 per-device rootfs，我们只要 040G-MD。
#    保留 nokia_xg-040g-md-ubi 与同板子的 ubi-usb-sfp 变体（同一块猫的两种
#    DTS 布局，多一个几乎不花时间，但能覆盖你板子实际是 SFP 变体的情况）。
#    这是「少编」而不是「改上游默认值」：所有被关掉的机型本身与本机无关。
#    MULTI_PROFILE 保持 y —— 它是多机型开关，单机型靠下面这些 is not set 收敛。
# ---------------------------------------------------------------------------
# CONFIG_TARGET_MULTI_PROFILE=y  ← 保持基座原值 y
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5382a is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-ct is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-ct-usb-sfp is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-cu is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-cu-usb-sfp is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_gemtek_xg2010g is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-tf-ubi is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_unionman_ung00a is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_znxt_zn504xg-d is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_znxt_zn515xg-d is not set
# 注意：不写 nokia_xg-040g-md-ubi-usb-sfp 的关闭行 —— 同一块猫的第二种 DTS 布局，
# 保留它几乎不多花时间，却能覆盖你板子实际是 SFP 变体的情况。

#!/bin/sh
# 首启启用射频：只把 wifi-device 的 disabled 置 0，不建 SSID、不动加密与密码。
#
# uci-defaults 的约定：脚本返回非 0 就留着下次开机再跑，返回 0 才自删。
# /etc/config/wireless 是 netifd/ucode 在首次探测到射频后才生成的，那时还没这个
# 文件就必须退出非 0 —— 否则"跑过一次"就把启用动作永久跳过了。
#
# 上游只做了 country：port/overlay/target/linux/rtl9617c/base-files/etc/
# board.d/03_wireless 仅 ucidef_set_country "CN"，README 也写明"启用无线"由用户
# 在 网络 → 无线 里操作，所以原厂固件的射频默认是关的。

. /lib/functions.sh

[ -f /etc/config/wireless ] || exit 1

found=0
set_device() {
	# config_get 读不到就说明这节没写 disabled；没写即视为已启用，不动它
	local cfg="$1" disabled
	uci get "wireless.$cfg.type" >/dev/null 2>&1 || return 0
	config_get disabled "$cfg" disabled
	[ "$disabled" = "1" ] && uci set "wireless.$cfg.disabled=0"
	found=1
}

config_load wireless
config_foreach set_device wifi-device

# 一个 wifi-device 都还没有（探测未完成/驱动没起来）→ 保留脚本，下次开机再试
[ "$found" = "1" ] || exit 1

uci commit wireless
wifi reload >/dev/null 2>&1 || true
exit 0

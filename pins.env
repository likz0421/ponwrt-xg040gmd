# ============================================================
# 锁定版本：改这里 = 换版本；不改则每次构建字节级可复现
# 全部用完整 SHA（workflow 用 git fetch --depth 1 origin <SHA>）
# ============================================================

# 源码基座（ImmortalWrt master + Airoha AN758x target）
PONWRT_URL=https://github.com/pbs05/ponwrt
PONWRT_SHA=03c134544714617e196dd399c85ebb90fb6eefa1   # master @ 2026-10-23

# PON 内核驱动（kmod-airoha-xpon / kmod-airoha-pon-frontend / en7572 …）
PON_DRIVERS_URL=https://github.com/pbs05/openwrt-pon-drivers
PON_DRIVERS_SHA=2f248394e62648800ef8d03ded623eb6d6059597

# PON 用户态（airoha-pond / airoha-ponctl / luci-app-pon / luci-app-iptv）
PON_USERSPACE_URL=https://github.com/pbs05/openwrt-pon-userspace
PON_USERSPACE_SHA=cce9d756742487b378749c606b30e13ee9b0f093

# 两个附加 LuCI 插件（NAT 类型 / PON 光模块卡片）
LUCI_APP_URL=https://github.com/qwe-qaq/luci-app
LUCI_APP_SHA=1938901826bbe43aab1b70308d611ed4dc720da1

# ImmortalWrt 官方 feeds（packages/luci 等）跟着基座走，不单独锁：
# feeds.conf.default 在 PONWRT_SHA 里已写死 URL 与分支名，
# workflow 会把这些 feed 也 checkout 到 update 当时的 SHA 并打印出来。

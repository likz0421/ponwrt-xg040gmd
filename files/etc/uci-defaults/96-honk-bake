#!/bin/sh
# 首启离线安装预置的 honk 全家桶
#   文件：/etc/apk/local/*.apk（构建时按 sha256 钉死抓自 daeuniverse 签名仓库）
#   验签：/etc/apk/keys/daeuniverse.pem（已在镜像里）—— 所以不用 --allow-untrusted
#   依赖：libstdcpp / kmod-veth / kmod-sched-core / kmod-sched-bpf / kmod-nft-core /
#         kmod-nft-queue / kmod-nfnetlink-queue / kmod-nf-conntrack /
#         v2ray-geoip / v2ray-geosite 都由构建提前编进固件，不需要联网
#   BTF：内核自带 BTF，vmlinux-btf-builtin（空包 PROVIDES vmlinux-btf）满足 honk 的依赖
#
# 安装失败时 exit 1：uci-defaults 只有在返回 0 时才删除自己，
# 返回非 0 就下次开机继续重试，不会变成"以为装了其实没装"。
[ -d /etc/apk/local ] || exit 0
ls /etc/apk/local/*.apk >/dev/null 2>&1 || exit 0
command -v apk >/dev/null 2>&1 || exit 1

if ! apk add /etc/apk/local/*.apk; then
	echo "96-honk-bake: 预置 apk 安装失败，稍后重试；手动可跑 apk add /etc/apk/local/*.apk" >&2
	exit 1
fi

# 装成就把文件删掉（省 ~7MB 占用；要重装去 /etc/apk/repositories.d/daeuniverse.list 的在线源）
rm -rf /etc/apk/local
# honk 服务默认是关的（他们 Makefile 明写 enabled by default = off），
# 在 LuCI 里配好节点和分流再启用，避免一开机就改 TC/cgroup/sysctl。
/etc/init.d/rpcd reload 2>/dev/null
rm -f /tmp/luci-indexcache.*
rm -rf /tmp/luci-modulecache/
exit 0
